DATABASE_URL="file:./dev.db"

# One-time key to create the first /admin account. Set a real random
# value in production; not needed once an admin account exists.
ADMIN_BOOTSTRAP_KEY="change-me"

# Signs the admin session cookie — set a long random value in production.
ADMIN_SESSION_SECRET="change-me"

# Optional: notify a Telegram chat when a new application/callback comes in.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# Optional analytics — leave unset to keep them off entirely.
# NEXT_PUBLIC_YM_ID=""
# NEXT_PUBLIC_GA_ID=""

# Used to build sitemap.xml/robots.txt and OG links — set to the real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
