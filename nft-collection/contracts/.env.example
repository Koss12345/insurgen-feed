# Copy to .env and fill in — never commit the real .env (it holds your wallet seed).

# 24-word seed phrase of the wallet that will own the collection and pay for gas.
MNEMONIC="word1 word2 word3 ... word24"

# Testnet first, always. Switch to https://toncenter.com/api/v2/jsonRPC only once
# everything has been verified end-to-end on testnet.
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC

# Free API key from https://t.me/tonapibot
TON_API_KEY=

# Where collection.json ended up after uploading generator/output/ to IPFS, e.g.:
# https://gateway.pinata.cloud/ipfs/bafybe.../collection.json
COLLECTION_CONTENT_URI=

# Optional — defaults to the deployer wallet if unset.
ROYALTY_DESTINATION=

# Optional — defaults to 100.
MAX_SUPPLY=100

# Filled in after deploy.ts prints the collection address.
COLLECTION_ADDRESS=
